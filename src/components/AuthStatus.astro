<div id="auth-status" class="auth-status">
  <button id="auth-signin" class="auth-signin-btn">
    <svg width="16" height="16" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
      <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84c-.21 1.13-.85 2.09-1.81 2.73v2.27h2.92c1.71-1.57 2.69-3.89 2.69-6.64z"/>
      <path fill="#34A853" d="M9 18c2.43 0 4.47-.81 5.96-2.18l-2.92-2.27c-.81.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.71H.96v2.34C2.44 15.98 5.48 18 9 18z"/>
      <path fill="#FBBC05" d="M3.97 10.7c-.18-.54-.28-1.11-.28-1.7s.1-1.16.28-1.7V4.96H.96C.35 6.17 0 7.55 0 9s.35 2.83.96 4.04l3.01-2.34z"/>
      <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.59-2.59C13.46.89 11.43 0 9 0 5.48 0 2.44 2.02.96 4.96l3.01 2.34C4.68 5.16 6.66 3.58 9 3.58z"/>
    </svg>
    Sign in with Google
  </button>

  <div id="auth-user" class="auth-user" hidden>
    <button id="account-toggle" class="account-toggle">
      <span id="auth-email"></span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <div id="account-menu" class="account-menu">
      <a href="/blog/write/">Write a Story</a>
      <a href="/account/my-stories/">My Stories</a>
      <a href="/independents/submit/">My Profile</a>
      <div class="account-menu-divider"></div>
      <button id="auth-signout" class="account-menu-signout">Sign out</button>
    </div>
  </div>
</div>

<script>
  import { supabase } from "../lib/supabase";

  const signinBtn = document.querySelector("#auth-signin") as HTMLElement;
  const userBox = document.querySelector("#auth-user") as HTMLElement;
  const emailSpan = document.querySelector("#auth-email") as HTMLElement;
  const accountToggle = document.querySelector("#account-toggle") as HTMLElement;
  const accountMenu = document.querySelector("#account-menu") as HTMLElement;
  const signoutBtn = document.querySelector("#auth-signout") as HTMLElement;

  async function updateAuthUI() {
    const { data: { session } } = await supabase.auth.getSession();

    if (session?.user) {
      signinBtn.style.display = "none";
      userBox.style.display = "flex";
      emailSpan.textContent = session.user.email ?? "";
    } else {
      signinBtn.style.display = "inline-flex";
      userBox.style.display = "none";
    }
  }

  signinBtn?.addEventListener("click", async () => {
    await supabase.auth.signInWithOAuth({
      provider: "google",
      options: { redirectTo: window.location.href },
    });
  });

  accountToggle?.addEventListener("click", () => {
    accountMenu?.classList.toggle("open");
  });

  document.addEventListener("click", (e) => {
    if (!userBox.contains(e.target as Node)) {
      accountMenu?.classList.remove("open");
    }
  });

  signoutBtn?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    accountMenu?.classList.remove("open");
    updateAuthUI();
  });

  supabase.auth.onAuthStateChange(() => updateAuthUI());
  updateAuthUI();
</script>

<style>
  .auth-status {
    display: flex;
    align-items: center;
    position: relative;
  }

  .auth-signin-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: #1c1c1e;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .auth-signin-btn:hover {
    border-color: #8aa7ff;
    transform: translateY(-1px);
  }

  .auth-user {
    display: none;
    position: relative;
  }

  .account-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
    padding: 6px 12px;
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
  }

  .account-toggle:hover {
    border-color: #8aa7ff;
  }

  .account-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 200px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.22);
    z-index: 30;
  }

  .account-menu.open {
    display: flex;
    flex-direction: column;
  }

  .account-menu a,
  .account-menu-signout {
    display: block;
    width: 100%;
    text-align: left;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--text);
    font-size: 13.5px;
    background: none;
    border: none;
    font-family: inherit;
    cursor: pointer;
  }

  .account-menu a:hover,
  .account-menu-signout:hover {
    background: color-mix(in srgb, #8aa7ff 10%, transparent);
    color: #8aa7ff;
  }

  .account-menu-signout {
    color: #e57373;
  }

  .account-menu-signout:hover {
    background: color-mix(in srgb, #e57373 10%, transparent);
    color: #e57373;
  }

  .account-menu-divider {
    height: 1px;
    background: var(--line);
    margin: 6px 4px;
  }
</style>