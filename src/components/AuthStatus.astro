<div id="auth-status" class="auth-status">
  <a href="/login" id="auth-signin" class="auth-link">Sign in</a>
  <div id="auth-user" class="auth-user" hidden>
    <span id="auth-email"></span>
    <button id="auth-signout" class="auth-signout">Sign out</button>
  </div>
</div>

<script>
  import { supabase } from "../lib/supabase";

  const signinLink = document.querySelector("#auth-signin") as HTMLElement;
  const userBox = document.querySelector("#auth-user") as HTMLElement;
  const emailSpan = document.querySelector("#auth-email") as HTMLElement;
  const signoutBtn = document.querySelector("#auth-signout") as HTMLElement;

  async function updateAuthUI() {
    const { data: { session } } = await supabase.auth.getSession();

    if (session?.user) {
      signinLink.style.display = "none";
      userBox.style.display = "flex";
      emailSpan.textContent = session.user.email ?? "";
    } else {
      signinLink.style.display = "inline";
      userBox.style.display = "none";
    }
  }

  signoutBtn?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    updateAuthUI();
  });

  supabase.auth.onAuthStateChange(() => updateAuthUI());
  updateAuthUI();
</script>

<style>
  .auth-status {
    display: flex;
    align-items: center;
  }

  .auth-link {
    color: #8aa7ff;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }

  .auth-user {
    display: none;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: #f5f5f7;
  }

  .auth-signout {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: #858a95;
    padding: 6px 12px;
    font-size: 13px;
    cursor: pointer;
  }

  .auth-signout:hover {
    border-color: #8aa7ff;
    color: #8aa7ff;
  }
</style>