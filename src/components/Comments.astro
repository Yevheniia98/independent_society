---
interface Props {
  postSlug: string;
}
const { postSlug } = Astro.props;
---

<div class="comments" data-slug={postSlug}>
  <h3>Comments</h3>

  <form id="comment-form" class="comment-form">
    <textarea id="comment-text" placeholder="Share your thoughts..." rows="3"></textarea>
    <button type="submit">Post comment</button>
  </form>
  <p id="comment-message" class="comment-message"></p>

  <div id="comment-list" class="comment-list"></div>
</div>

<script>
  import { supabase } from "../lib/supabase";

  const container = document.querySelector(".comments") as HTMLElement;
  const slug = container.dataset.slug!;
  const form = document.querySelector("#comment-form") as HTMLFormElement;
  const textarea = document.querySelector("#comment-text") as HTMLTextAreaElement;
  const message = document.querySelector("#comment-message") as HTMLElement;
  const list = document.querySelector("#comment-list") as HTMLElement;

  function escapeHtml(str: string) {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  function initials(email: string) {
    return email.slice(0, 2).toUpperCase();
  }

  function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  async function loadComments() {
    const { data: { session } } = await supabase.auth.getSession();
    const currentUserId = session?.user?.id;

    const { data } = await supabase
      .from("comments")
      .select("id, user_id, author_email, content, created_at")
      .eq("post_slug", slug)
      .order("created_at", { ascending: false });

    if (!data || data.length === 0) {
      list.innerHTML = `<p class="no-comments">No comments yet. Be the first!</p>`;
      return;
    }

    list.innerHTML = data
      .map((c) => {
        const name = c.author_email.split("@")[0];
        const isOwner = c.user_id === currentUserId;
        return `
        <div class="comment" data-id="${c.id}">
          <div class="comment-avatar">${initials(c.author_email)}</div>
          <div class="comment-body">
            <div class="comment-header">
              <span class="comment-author">${escapeHtml(name)}</span>
              <span class="comment-date">${formatDate(c.created_at)}</span>
              ${isOwner ? `
  <button class="comment-edit-btn" data-id="${c.id}">Edit</button>
  <button class="comment-delete-btn" data-id="${c.id}">Delete</button>
` : ""}
            </div>
            <div class="comment-content" data-original="${escapeHtml(c.content)}">${escapeHtml(c.content)}</div>
          </div>
        </div>
      `;
      })
      .join("");

    attachEditHandlers();
    attachDeleteHandlers();
  }

  function attachEditHandlers() {
    const editButtons = list.querySelectorAll<HTMLButtonElement>(".comment-edit-btn");

    editButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const commentEl = btn.closest(".comment") as HTMLElement;
        const contentEl = commentEl.querySelector(".comment-content") as HTMLElement;
        const commentId = btn.dataset.id!;
        const originalText = contentEl.dataset.original || contentEl.textContent || "";

        contentEl.innerHTML = `
          <textarea class="comment-edit-textarea">${originalText}</textarea>
          <div class="comment-edit-actions">
            <button class="comment-save-btn">Save</button>
            <button class="comment-cancel-btn">Cancel</button>
          </div>
        `;

        const editTextarea = contentEl.querySelector(".comment-edit-textarea") as HTMLTextAreaElement;
        const saveBtn = contentEl.querySelector(".comment-save-btn") as HTMLButtonElement;
        const cancelBtn = contentEl.querySelector(".comment-cancel-btn") as HTMLButtonElement;

        editTextarea.focus();

        cancelBtn.addEventListener("click", () => {
          loadComments();
        });

        saveBtn.addEventListener("click", async () => {
          const newContent = editTextarea.value.trim();
          if (!newContent) return;

          const { error } = await supabase
            .from("comments")
            .update({ content: newContent })
            .eq("id", commentId);

          if (!error) {
            await loadComments();
          }
        });
      });
    });
  }

  function attachDeleteHandlers() {
    const deleteButtons = list.querySelectorAll<HTMLButtonElement>(".comment-delete-btn");

    deleteButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const confirmed = confirm("Delete this comment?");
        if (!confirmed) return;

        const commentId = btn.dataset.id!;
        const { error } = await supabase
          .from("comments")
          .delete()
          .eq("id", commentId);

        if (!error) {
          await loadComments();
        }
      });
    });
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const content = textarea.value.trim();
    if (!content) {
      message.textContent = "Please write something first.";
      return;
    }

    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) {
      message.textContent = "Please sign in to comment.";
      return;
    }

    const { error } = await supabase.from("comments").insert({
      post_slug: slug,
      user_id: session.user.id,
      author_email: session.user.email,
      content,
    });

    if (error) {
      message.textContent = "Something went wrong. Please try again.";
    } else {
      textarea.value = "";
      message.textContent = "";
      await loadComments();
    }
  });

  loadComments();
</script>

<style>
  .comments {
    margin: 56px 0;
  }

  .comments h3 {
    color: var(--text);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 8px;
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  .comment-form textarea {
    padding: 14px 16px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    resize: vertical;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .comment-form textarea:focus {
    outline: none;
    border-color: #8aa7ff;
    box-shadow: 0 0 0 3px color-mix(in srgb, #8aa7ff 15%, transparent);
  }

  .comment-form button {
    align-self: flex-start;
    padding: 10px 22px;
    background: #8aa7ff;
    border: none;
    border-radius: 10px;
    color: #08090d;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  .comment-form button:hover {
    background: #c2d1ff;
    transform: translateY(-1px);
  }

  .comment-form button:active {
    transform: translateY(0);
  }

  .comment-message {
    color: #8aa7ff;
    font-size: 13px;
    font-weight: 500;
    min-height: 18px;
    margin: 4px 0 28px 4px;
  }

  .comment-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .comment-list :global(.comment) {
    display: flex;
    gap: 14px;
    padding: 18px 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.2s ease;
  }

  .comment-list :global(.comment:hover) {
    border-color: color-mix(in srgb, #8aa7ff 30%, var(--line));
  }

  .comment-list :global(.comment-avatar) {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: color-mix(in srgb, #8aa7ff 15%, transparent);
    color: #8aa7ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
  }

  .comment-list :global(.comment-body) {
    flex: 1;
    min-width: 0;
  }

  .comment-list :global(.comment-header) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .comment-list :global(.comment-author) {
    font-weight: 600;
    color: var(--text);
    font-size: 14px;
  }

  .comment-list :global(.comment-date) {
    color: var(--muted);
    font-size: 12px;
  }

  .comment-list :global(.comment-content) {
    color: var(--text);
    opacity: 0.82;
    font-size: 14.5px;
    line-height: 1.6;
  }

  .comment-list :global(.comment-edit-btn),
  .comment-list :global(.comment-delete-btn) {
    margin-left: auto;
    background: none;
    border: none;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    transition: background 0.15s ease;
  }

  .comment-list :global(.comment-edit-btn) {
    color: #8aa7ff;
    margin-left: auto;
  }

  .comment-list :global(.comment-delete-btn) {
    color: #e57373;
    margin-left: 0;
  }

  .comment-list :global(.comment-edit-btn:hover) {
    background: color-mix(in srgb, #8aa7ff 12%, transparent);
  }

  .comment-list :global(.comment-delete-btn:hover) {
    background: color-mix(in srgb, #e57373 12%, transparent);
  }

  .comment-list :global(.comment-edit-textarea) {
    width: 100%;
    padding: 12px 14px;
    background: var(--bg);
    border: 1px solid #8aa7ff;
    border-radius: 10px;
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    resize: vertical;
    margin-bottom: 10px;
    box-sizing: border-box;
  }

  .comment-list :global(.comment-edit-actions) {
    display: flex;
    gap: 8px;
  }

  .comment-list :global(.comment-save-btn) {
    padding: 7px 16px;
    background: #8aa7ff;
    border: none;
    border-radius: 8px;
    color: #08090d;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }

  .comment-list :global(.comment-cancel-btn) {
    padding: 7px 16px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
  }

  .no-comments {
    color: var(--muted);
    font-size: 14px;
    padding: 24px;
    text-align: center;
    background: var(--panel);
    border: 1px dashed var(--line);
    border-radius: 14px;
  }
</style>