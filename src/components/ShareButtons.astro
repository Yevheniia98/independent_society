---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const shareLinks = [
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: "linkedin",
  },
  {
    name: "X",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    icon: "x",
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: "facebook",
  },
  {
    name: "Reddit",
    href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
    icon: "reddit",
  },
  {
    name: "WhatsApp",
    href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
    icon: "whatsapp",
  },
  {
    name: "Email",
    href: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
    icon: "email",
  },
];
---

<div class="share-buttons">
  <span class="share-label">Share this story</span>
  <div class="share-icons">
    {shareLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="share-icon"
        aria-label={`Share on ${link.name}`}
        title={`Share on ${link.name}`}
      >
        {link.icon === "linkedin" && (
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" />
          </svg>
        )}
        {link.icon === "x" && (
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M18.9 2H22l-7.6 8.7L23.3 22h-7.1l-5.5-7.2L4.3 22H1.2l8.1-9.3L1 2h7.2l5 6.6L18.9 2zm-1.2 18h1.7L7.4 4h-1.8l12.1 16z" />
          </svg>
        )}
        {link.icon === "facebook" && (
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.87.24-1.46 1.5-1.46h1.6V4.35C15.87 4.24 14.9 4.15 13.77 4.15c-2.34 0-3.94 1.43-3.94 4.05v2.26H7.2v3h2.63V21h3.67z" />
          </svg>
        )}
        {link.icon === "reddit" && (
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M22 12c0-1.1-.9-2-2-2-.53 0-1 .2-1.36.53-1.34-.93-3.17-1.53-5.2-1.6l.9-4.2 2.9.62a1.5 1.5 0 1 0 .15-.86l-3.24-.69a.43.43 0 0 0-.51.34l-1 4.7c-2 .07-3.82.67-5.15 1.6A1.98 1.98 0 0 0 4 10c-1.1 0-2 .9-2 2 0 .8.48 1.5 1.16 1.8-.03.2-.05.4-.05.6 0 2.8 3.3 5.1 7.4 5.1s7.4-2.3 7.4-5.1c0-.2-.02-.4-.05-.6.68-.3 1.14-1 1.14-1.8zM8.2 13.3a1.1 1.1 0 1 1 2.2 0 1.1 1.1 0 0 1-2.2 0zm7.4 3.2c-.86.86-2.5.93-3.6.93s-2.74-.07-3.6-.93a.35.35 0 1 1 .5-.5c.6.6 1.87.77 3.1.77s2.5-.17 3.1-.77a.35.35 0 0 1 .5.5zm-.2-2.1a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2z" />
          </svg>
        )}
        {link.icon === "whatsapp" && (
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.39 1.26 4.81L2 22l5.42-1.35a9.87 9.87 0 0 0 4.62 1.14h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.13-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.06a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.1.78.83-3.02-.2-.31a8.13 8.13 0 0 1-1.26-4.28c0-4.5 3.66-8.16 8.17-8.16 2.18 0 4.23.85 5.77 2.39a8.1 8.1 0 0 1 2.39 5.78c0 4.5-3.67 8.14-8.12 8.14zm4.47-6.1c-.24-.12-1.45-.72-1.67-.8-.22-.08-.39-.12-.55.12-.16.24-.63.8-.78.97-.14.16-.28.18-.53.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.44-1.35-1.68-.14-.24-.02-.37.11-.5.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.45-.59 1.65-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28z" />
          </svg>
        )}
        {link.icon === "email" && (
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1.7 2 7.3 5.6L19.3 7H4.7zM20 8.3l-7.4 5.7a1 1 0 0 1-1.2 0L4 8.3V17h16V8.3z" />
          </svg>
        )}
      </a>
    ))}
    <button class="share-icon copy-link" id="copy-link-btn" aria-label="Copy link" title="Copy link">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M3.9 12a4.1 4.1 0 0 1 4.1-4.1h4v1.7H8a2.4 2.4 0 1 0 0 4.8h4v1.7H8A4.1 4.1 0 0 1 3.9 12zm6.1.9v-1.8h4v1.8h-4zm2-4.9h4a4.1 4.1 0 0 1 0 8.2h-4v-1.7h4a2.4 2.4 0 1 0 0-4.8h-4V8z"/>
      </svg>
    </button>
  </div>
</div>

<script>
  const copyBtn = document.getElementById("copy-link-btn");
  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      const original = copyBtn.getAttribute("title");
      copyBtn.setAttribute("title", "Copied!");
      setTimeout(() => copyBtn.setAttribute("title", original ?? "Copy link"), 1500);
    } catch (err) {
      console.error("Failed to copy link:", err);
    }
  });
</script>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 36px 0;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .share-label {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-right: 4px;
  }

  .share-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .share-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .share-icon:hover {
    border-color: #8aa7ff;
    transform: translateY(-2px);
  }

  .copy-link {
    font: inherit;
  }
</style>