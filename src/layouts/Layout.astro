---
import "../styles/global.css";
import AuthStatus from "../components/AuthStatus.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
const { title = "Independent Society", description = "Stories for freelancers, founders and small teams building independent businesses.", canonical } = Astro.props;
const url = canonical ?? Astro.url.href;
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      const theme = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", theme);
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/ISG.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6483070812951334"
      crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="logo" href="/">
          <img src="/images/ISG.png" alt="Independent Society" style="height: 50px;" />
        </a>

        <div class="nav-right">
          <nav class="nav-links" id="nav-links">
            <a href="/blog/">Stories</a>
            <a href="/independents/">Independents</a>
            <a href="/#categories">Categories</a>
            <a href="/about/">About</a>
            <div class="nav-links-divider"></div>
            <AuthStatus />
          </nav>

          <ThemeToggle />

          <button class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false">
            <svg class="icon-open" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <svg class="icon-close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="5" y1="5" x2="19" y2="19"></line>
              <line x1="19" y1="5" x2="5" y2="19"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="container">
        Independent Society — practical stories from freelancers, founders and small teams.
        <p>© 2026</p>
        <nav class="footer-links">
          <a href="/contact/">Contact</a>
          <a href="/privacy-policy/">Privacy Policy</a>
        </nav>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById("menu-toggle");
      const links = document.getElementById("nav-links");

      toggle?.addEventListener("click", () => {
        const isOpen = links?.classList.toggle("open");
        toggle.classList.toggle("open", !!isOpen);
        toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });

      links?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          links.classList.remove("open");
          toggle?.classList.remove("open");
          toggle?.setAttribute("aria-expanded", "false");
        });
      });
    </script>
  </body>
</html>

<style>
  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .menu-toggle {
    display: none;
    position: relative;
    background: none;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle:hover {
    border-color: #8aa7ff;
  }

  .menu-toggle .icon-open,
  .menu-toggle .icon-close {
    position: absolute;
  }

  .menu-toggle .icon-close {
    display: none;
  }

  .menu-toggle.open .icon-open {
    display: none;
  }

  .menu-toggle.open .icon-close {
    display: block;
  }

  footer .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  footer .footer-links a {
    color: inherit;
    opacity: 0.7;
    text-decoration: none;
    font-size: 0.9rem;
    margin-right: 1.25rem;
    display: inline-block;
  }

  footer .footer-links a:not(:last-child)::after {
    content: "·";
    margin-left: 1.25rem;
    opacity: 0.4;
  }

  footer .footer-links a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      margin: 0;
      padding: 12px 20px 24px;
      background: var(--panel);
      border-bottom: 1px solid var(--line);
      border-radius: 0 0 20px 20px;
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.22);
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      padding: 12px 4px;
      font-size: 1.02rem;
      border-radius: 10px;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .nav-links a:hover {
      background: color-mix(in srgb, #8aa7ff 10%, transparent);
      color: #8aa7ff;
    }

    .nav-links-divider {
      height: 1px;
      background: var(--line);
      margin: 10px 4px 12px;
    }
  }

  @media (min-width: 769px) {
    .nav-links-divider {
      display: none;
    }
  }
</style>