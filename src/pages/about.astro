---
import Layout from "../layouts/Layout.astro";
import "../styles/about.css";
---

<Layout title="About — Independent Society">
  <main class="about-page">

    <!-- HERO -->
    <section class="about-hero">
      <div class="about-eyebrow">
        <span class="about-eyebrow-dot"></span>
        ABOUT
      </div>

      <h1>
        Independent <span>Society</span>
      </h1>

      <div class="about-intro">
        <p>
          It’s when you no longer want to follow someone else’s rules.
        </p>
        <p>
          When you believe in yourself enough to try to create something of
          your own — even if you don’t know how it will turn out. Even if you
          don’t have the perfect preparation, experience, or a clear plan.
        </p>
      </div>

      <a href="#story" class="about-scroll">
        Discover the idea
        <span>↓</span>
      </a>
    </section>

    <!-- THE IDEA -->
    <section id="story" class="about-section">
      <div class="about-section-number">
        <span>01</span>
        <i></i>
        THE IDEA
      </div>

      <div class="journey-grid">
        <div class="journey-copy">
          <h2>
            Maybe it won’t be perfect.<br />
            Maybe you’ll start over.
          </h2>
          <p>But it will be yours.</p>
          <p>
            <strong>Independent Society</strong> is a space for those who choose their own path instead of following a predefined one.
          </p>
        </div>

        <div class="lesson-card">
          <div class="lesson-number">01</div>
          <div class="lesson-icon"><span>✦</span></div>
          <div class="lesson-content">
            <div class="lesson-label">THE MINDSET</div>
            <h3>You don’t need to have everything figured out.</h3>
            <div class="lesson-line"></div>
            <p>
              You only need enough courage to take the next step, question what doesn’t feel right, and find your own way.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT THIS IS ABOUT -->
    <section class="about-section about-purpose">
      <div class="about-section-number">
        <span>02</span>
        <i></i>
        WHAT THIS IS ABOUT
      </div>

      <div class="purpose-grid">
        <div class="purpose-copy">
          <h2>
            Life outside <span>the predefined path.</span>
          </h2>
          <p>
            Here, I write about what happens beyond the familiar:
            the courage to begin, the doubts, the mistakes, the unexpected
            turns, the work, the people, and the decisions that gradually
            shape where we’re going.
          </p>
          <p>
            No gurus. No perfect picture. No overnight success story.
          </p>
          <p>
            Just life, work, and the attempts to do things your own way.
          </p>
        </div>

        <div class="values-grid">
          <article class="value-card">
            <div class="value-top">
              <span>01</span>
              <div class="value-icon">↗</div>
            </div>
            <h3>Question</h3>
            <p>Challenge the rules and assumptions you’ve been given.</p>
          </article>

          <article class="value-card">
            <div class="value-top">
              <span>02</span>
              <div class="value-icon">◫</div>
            </div>
            <h3>Explore</h3>
            <p>Try different paths and learn from what happens along the way.</p>
          </article>

          <article class="value-card">
            <div class="value-top">
              <span>03</span>
              <div class="value-icon">✦</div>
            </div>
            <h3>Choose</h3>
            <p>Build a life and a way of working that feels like your own.</p>
          </article>
        </div>
      </div>

      <!-- FOOTER QUOTE -->
      <div class="about-quote">
        <div class="quote-mark">“</div>
        <div class="quote-text">
          <p>You don’t need permission to choose your own way.</p>
          <p>Welcome to Independent Society.</p>
        </div>
        <div class="signature">
          Jenny <span>♡</span>
        </div>
      </div>
    </section>

  </main>
</Layout>