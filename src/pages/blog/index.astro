---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const rawPosts = await getCollection("blog");

const posts = rawPosts
  .map((post) => ({
    ...post,
    slug: post.slug || post.id.replace(/\.md$/, ""),
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Stories — Independent Society">
  <main class="stories-page">
    <div class="stories-container">
      
      <!-- HERO -->
      <header class="stories-hero">
        <div class="hero-eyebrow">
          <span class="dot"></span>
          <span>INDEPENDENT BUILDERS</span>
        </div>
        <h1>Stories</h1>
        <p class="hero-lead">
          Freelancing, startups, business, AI, and the reality of building independently.
        </p>

        <!-- SEARCH BAR -->
        <div class="search-wrap">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            class="search-input"
            id="search"
            type="search"
            placeholder="Search stories, categories, or keywords..."
            aria-label="Search stories"
          />
        </div>
      </header>

      <!-- POSTS GRID -->
      <section class="grid-wrap">
        <div class="grid" id="posts">
          {posts.map((post) => (
            <a
              class="card post"
              data-search={`${post.data.title} ${post.data.description} ${post.data.category} ${(post.data.tags || []).join(" ")}`}
              href={`/blog/${post.slug}`}
            >
              <div class="card-content">
                <div class="meta">
                  <span class="category">{post.data.category}</span>
                  <span class="sep">•</span>
                  <span>{post.data.readingTime}</span>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>

              <div class="card-bottom">
                <span class="author">{post.data.author}</span>
                <span class="date">
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
              </div>
            </a>
          ))}
        </div>

        <!-- EMPTY SEARCH STATE -->
        <div class="empty" id="empty" hidden>
          <div class="empty-icon">🔍</div>
          <h3>No stories found</h3>
          <p>Try searching for another keyword or topic.</p>
        </div>
      </section>

    </div>
  </main>

  <script>
    const input = document.querySelector("#search") as HTMLInputElement;
    const cards = [...document.querySelectorAll<HTMLElement>(".post")];
    const empty = document.querySelector("#empty") as HTMLElement;

    input?.addEventListener("input", () => {
      const q = input.value.toLowerCase().trim();
      let count = 0;

      cards.forEach((card) => {
        const match = card.dataset.search?.toLowerCase().includes(q) ?? false;
        card.style.display = match ? "flex" : "none";
        if (match) count++;
      });

      if (empty) {
        empty.hidden = count !== 0;
      }
    });
  </script>
</Layout>

<style>
  /* SCOPED STYLES */
  .stories-page {
    --bg: #08090d;
    --card-bg: linear-gradient(145deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    --text: #f5f5f7;
    --text-muted: #858a95;
    --accent: #8aa7ff;
    --accent-light: #c2d1ff;
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(138, 167, 255, 0.35);

    min-height: 100vh;
    background-color: var(--bg);
    background-image: radial-gradient(
      circle at 50% 0%,
      rgba(83, 105, 255, 0.12),
      transparent 50%
    );
    color: var(--text);
    padding-bottom: 120px;
  }

  .stories-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* HERO HEADER */
  .stories-hero {
    padding: 120px 0 60px;
    max-width: 760px;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(138, 167, 255, 0.08);
    border: 1px solid rgba(138, 167, 255, 0.2);
    border-radius: 99px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-bottom: 24px;
  }

  .hero-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .stories-hero h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 20px;
  }

  .hero-lead {
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0 0 40px;
  }

  /* SEARCH INPUT */
  .search-wrap {
    position: relative;
    max-width: 540px;
  }

  .search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .search-input {
    width: 100%;
    padding: 16px 20px 16px 48px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 14px;
    color: #ffffff;
    font-size: 15px;
    outline: none;
    transition: all 0.25s ease;
    box-sizing: border-box;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input:focus {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(138, 167, 255, 0.15);
  }

  .search-wrap:focus-within .search-icon {
    color: var(--accent);
  }

  /* GRID */
  .grid-wrap {
    border-top: 1px solid var(--border);
    padding-top: 60px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }

  /* CARDS */
  .card.post {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 32px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .card.post:hover {
    background: linear-gradient(145deg, rgba(138, 167, 255, 0.06), rgba(255, 255, 255, 0.02));
    border-color: var(--border-hover);
    transform: translateY(-3px);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .meta .category {
    color: var(--accent);
  }

  .meta .sep {
    opacity: 0.4;
  }

  .card h3 {
    color: #ffffff;
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    transition: color 0.2s ease;
  }

  .card.post:hover h3 {
    color: var(--accent-light);
  }

  .card p {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 12px;
    color: var(--text-muted);
  }

  .card-bottom .author {
    font-weight: 600;
    color: var(--text);
  }

  /* EMPTY STATE */
  .empty {
    padding: 80px 0;
    text-align: center;
  }

  .empty-icon {
    font-size: 32px;
    margin-bottom: 16px;
  }

  .empty h3 {
    color: #ffffff;
    font-size: 20px;
    margin: 0 0 8px;
  }

  .empty p {
    color: var(--text-muted);
    font-size: 14px;
    margin: 0;
  }

  /* RESPONSIVE DESIGN */
  @media (max-width: 768px) {
    .stories-hero {
      padding: 80px 0 40px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .card.post {
      padding: 24px;
    }
  }
</style>