---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const rawPosts = await getCollection("blog");

const posts = rawPosts
  .map((post) => ({
    ...post,
    slug: post.slug || post.id.replace(/\.md$/, ""),
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Stories — Independent Society">
  <main class="stories-page">
    <div class="stories-container">
      
      <!-- HERO -->
      <header class="stories-hero">
        <div class="hero-top-row">
          <div class="hero-eyebrow">
            <span class="dot"></span>
            <span>INDEPENDENT BUILDERS</span>
          </div>
          <a href="/blog/write/" class="write-cta">+ Write a Story</a>
        </div>
        <h1>Stories</h1>
        <p class="hero-lead">
          Freelancing, startups, business, AI, and the reality of building independently.
        </p>

        <!-- SEARCH BAR -->
        <div class="search-wrap">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            class="search-input"
            id="search"
            type="search"
            placeholder="Search stories, categories, or keywords..."
            aria-label="Search stories"
          />
        </div>
      </header>

      <!-- POSTS GRID -->
      <section class="grid-wrap">
        <div class="grid" id="posts">
          {posts.map((post) => (
            
             <a class="card post"
              data-search={`${post.data.title} ${post.data.description} ${post.data.category} ${(post.data.tags || []).join(" ")}`}
              data-date={post.data.date.valueOf()}
              href={`/blog/${post.slug}`}
            >
              {post.data.cover && (
                <div class="card-image">
                  <img src={post.data.cover} alt={post.data.title} loading="lazy" />
                </div>
              )}
              <div class="card-content">
                <div class="meta">
                  <span class="category">{post.data.category}</span>
                  <span class="sep">•</span>
                  <span>{post.data.readingTime}</span>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>

              <div class="card-bottom">
                <span class="author">{post.data.author}</span>
                <span class="date">
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
              </div>
            </a>
          ))}
        </div>

        <!-- EMPTY SEARCH STATE -->
        <div class="empty" id="empty" hidden>
          <div class="empty-icon">🔍</div>
          <h3>No stories found</h3>
          <p>Try searching for another keyword or topic.</p>
        </div>
      </section>

    </div>
  </main>

  <script>
    import { supabase } from "../../lib/supabase";

    function escapeHtml(str: string) {
      const div = document.createElement("div");
      div.textContent = str ?? "";
      return div.innerHTML;
    }

    function estimateReadingTime(content: string) {
      const words = content.trim().split(/\s+/).length;
      const minutes = Math.max(1, Math.round(words / 200));
      return `${minutes} min read`;
    }

    async function loadCommunityStories() {
      const grid = document.querySelector("#posts") as HTMLElement;
      if (!grid) return;

      const { data, error } = await supabase
        .from("stories")
        .select("slug, title, description, category, cover_url, author_name, content, created_at")
        .eq("hidden", false);

      if (error || !data || data.length === 0) return;

      data.forEach((story) => {
        const card = document.createElement("a");
        card.className = "card post";
        card.href = `/blog/community/${story.slug}/`;
        card.dataset.date = new Date(story.created_at).valueOf().toString();
        card.dataset.search = `${story.title} ${story.description ?? ""} ${story.category ?? ""} ${story.author_name}`;

        card.innerHTML = `
          ${
            story.cover_url
              ? `<div class="card-image"><img src="${escapeHtml(story.cover_url)}" alt="${escapeHtml(story.title)}" loading="lazy" /></div>`
              : ""
          }
          <div class="card-content">
            <div class="meta">
              <span class="category">${escapeHtml(story.category || "Community")}</span>
              <span class="sep">•</span>
              <span>${estimateReadingTime(story.content)}</span>
            </div>
            <h3>${escapeHtml(story.title)}</h3>
            <p>${escapeHtml(story.description || "")}</p>
          </div>
          <div class="card-bottom">
            <span class="author">${escapeHtml(story.author_name)}</span>
            <span class="date">${new Date(story.created_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</span>
          </div>
        `;

        grid.appendChild(card);
      });

      // Re-sort every card (static posts + community stories) by date, newest first
      const allCards = [...grid.querySelectorAll<HTMLElement>(".post")];
      allCards
        .sort((a, b) => Number(b.dataset.date) - Number(a.dataset.date))
        .forEach((card) => grid.appendChild(card));
    }

    function bindSearch() {
      const input = document.querySelector("#search") as HTMLInputElement;
      const cards = [...document.querySelectorAll<HTMLElement>(".post")];
      const empty = document.querySelector("#empty") as HTMLElement;

      input?.addEventListener("input", () => {
        const q = input.value.toLowerCase().trim();
        let count = 0;

        cards.forEach((card) => {
          const match = card.dataset.search?.toLowerCase().includes(q) ?? false;
          card.style.display = match ? "flex" : "none";
          if (match) count++;
        });

        if (empty) {
          empty.hidden = count !== 0;
        }
      });
    }

    async function init() {
      await loadCommunityStories();
      bindSearch();
    }

    init();
  </script>
</Layout>

<style>
  /* SCOPED STYLES */
  .stories-page {
    --card-bg: color-mix(in srgb, var(--panel) 76%, transparent);

    min-height: 100vh;
    background-color: var(--bg);
    background-image: radial-gradient(
      circle at 50% 0%,
      color-mix(in srgb, var(--panel-2) 50%, transparent),
      transparent 50%
    );
    color: var(--text);
    padding-bottom: 120px;
  }

  .stories-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* HERO HEADER */
  .stories-hero {
    padding: 120px 0 60px;
    max-width: 760px;
  }

  .hero-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .write-cta {
    padding: 10px 20px;
    background: #8aa7ff;
    border-radius: 10px;
    color: #08090d;
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
    transition: background 0.2s ease;
  }

  .write-cta:hover {
    background: #c2d1ff;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: color-mix(in srgb, #8aa7ff 8%, transparent);
    border: 1px solid color-mix(in srgb, #8aa7ff 20%, transparent);
    border-radius: 99px;
    color: #8aa7ff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-bottom: 24px;
  }

  .hero-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8aa7ff;
    box-shadow: 0 0 8px #8aa7ff;
  }

  .stories-hero h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 20px;
  }

  .hero-lead {
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 40px;
  }

  /* SEARCH INPUT */
  .search-wrap {
    position: relative;
    max-width: 540px;
  }

  .search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .search-input {
    width: 100%;
    padding: 16px 20px 16px 48px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--text);
    font-size: 15px;
    outline: none;
    transition: all 0.25s ease;
    box-sizing: border-box;
  }

  .search-input::placeholder {
    color: var(--muted);
  }

  .search-input:focus {
    background: var(--panel-2);
    border-color: #8aa7ff;
    box-shadow: 0 0 20px color-mix(in srgb, #8aa7ff 15%, transparent);
  }

  .search-wrap:focus-within .search-icon {
    color: #8aa7ff;
  }

  /* GRID */
  .grid-wrap {
    border-top: 1px solid var(--line);
    padding-top: 60px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }

  /* CARDS */
  .card.post {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 32px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .card.post:hover {
    background: color-mix(in srgb, #8aa7ff 6%, var(--panel));
    border-color: color-mix(in srgb, #8aa7ff 35%, transparent);
    transform: translateY(-3px);
  }

  /* COVER IMAGE */
  .card-image {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .card.post:hover .card-image img {
    transform: scale(1.05);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .meta .category {
    color: #8aa7ff;
  }

  .meta .sep {
    opacity: 0.4;
  }

  .card h3 {
    color: var(--text);
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    transition: color 0.2s ease;
  }

  .card.post:hover h3 {
    color: #8aa7ff;
  }

  .card p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }

  .card-bottom .author {
    font-weight: 600;
    color: var(--text);
  }

  /* EMPTY STATE */
  .empty {
    padding: 80px 0;
    text-align: center;
  }

  .empty-icon {
    font-size: 32px;
    margin-bottom: 16px;
  }

  .empty h3 {
    color: var(--text);
    font-size: 20px;
    margin: 0 0 8px;
  }

  .empty p {
    color: var(--muted);
    font-size: 14px;
    margin: 0;
  }

  /* RESPONSIVE DESIGN */
  @media (max-width: 768px) {
    .stories-hero {
      padding: 80px 0 40px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .card.post {
      padding: 24px;
    }
  }

  /* Same rules as above, but :global() so they also apply to community
     story cards, which are inserted into #posts via JavaScript after the
     page has already rendered — scoped Astro styles don't reach them
     otherwise. */
  .grid :global(.card.post) {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 32px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .grid :global(.card.post:hover) {
    background: color-mix(in srgb, #8aa7ff 6%, var(--panel));
    border-color: color-mix(in srgb, #8aa7ff 35%, transparent);
    transform: translateY(-3px);
  }

  .grid :global(.card-image) {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .grid :global(.card-image img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .grid :global(.card.post:hover .card-image img) {
    transform: scale(1.05);
  }

  .grid :global(.meta) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .grid :global(.meta .category) {
    color: #8aa7ff;
  }

  .grid :global(.meta .sep) {
    opacity: 0.4;
  }

  .grid :global(.card h3) {
    color: var(--text);
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    transition: color 0.2s ease;
  }

  .grid :global(.card.post:hover h3) {
    color: #8aa7ff;
  }

  .grid :global(.card p) {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  .grid :global(.card-bottom) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }

  .grid :global(.card-bottom .author) {
    font-weight: 600;
    color: var(--text);
  }
</style>