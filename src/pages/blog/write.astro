---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Write a Story — Independent Society"
  description="Share your own story with the Independent Society community."
>
  <div class="container article-wrap" style="padding-top: 60px; max-width: 720px;">
    <div class="eyebrow">Community</div>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem);">Write a Story</h1>
    <p class="article-lead">
      Your story publishes immediately and appears in the Stories feed alongside
      everything else. Take your time — you can edit or delete it later from
      "My Stories".
    </p>

    <div id="signed-out-notice" class="notice" hidden>
      <p>You need to sign in with Google to write a story.</p>
    </div>

    <form id="story-form" class="story-form" hidden>
      <label>
        Title *
        <input type="text" id="f-title" required maxlength="120" />
      </label>

      <label>
        Short description <span class="optional">(shown in the feed, optional)</span>
        <input type="text" id="f-description" maxlength="200" />
      </label>

      <label>
        Category <span class="optional">(optional)</span>
        <input type="text" id="f-category" placeholder="e.g. Business, Self-improvement" maxlength="60" />
      </label>

      <label>
        Cover image <span class="optional">(optional)</span>
        <input type="file" id="f-cover" accept="image/png,image/jpeg,image/webp" />
      </label>

      <label>
        Your story *
        <textarea id="f-content" rows="14" required placeholder="Write your story here. Leave a blank line between paragraphs."></textarea>
      </label>

      <button type="submit" id="submit-btn">Publish story</button>
      <p id="form-message" class="form-message"></p>
    </form>
  </div>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  const signedOutNotice = document.querySelector("#signed-out-notice") as HTMLElement;
  const form = document.querySelector("#story-form") as HTMLFormElement;
  const message = document.querySelector("#form-message") as HTMLElement;
  const submitBtn = document.querySelector("#submit-btn") as HTMLButtonElement;

  function slugify(title: string) {
    const base = title
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, "-")
      .slice(0, 60);
    const random = Math.random().toString(36).slice(2, 6);
    return `${base}-${random}`;
  }

  function showError(text: string) {
    message.textContent = text;
    message.className = "form-message error";
  }

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session?.user) {
      signedOutNotice.hidden = false;
      form.hidden = true;
      return;
    }

    signedOutNotice.hidden = true;
    form.hidden = false;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      message.textContent = "";
      message.className = "form-message";

      const title = (document.querySelector("#f-title") as HTMLInputElement).value.trim();
      const content = (document.querySelector("#f-content") as HTMLTextAreaElement).value.trim();

      if (!title || !content) {
        showError("Please add a title and your story text.");
        return;
      }

      if (content.length < 200) {
        showError("Your story looks quite short — add a bit more detail before publishing (at least ~200 characters).");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Publishing…";

      try {
        let coverUrl: string | null = null;
        const fileInput = document.querySelector("#f-cover") as HTMLInputElement;
        const file = fileInput.files?.[0];

        if (file) {
          const ext = file.name.split(".").pop();
          const path = `${session.user.id}/story-${Date.now()}.${ext}`;

          const { error: uploadError } = await supabase.storage
            .from("avatars")
            .upload(path, file, { upsert: true });

          if (uploadError) throw new Error(`Cover upload failed: ${uploadError.message}`);

          const { data: publicUrlData } = supabase.storage.from("avatars").getPublicUrl(path);
          coverUrl = publicUrlData.publicUrl;
        }

        const authorName =
          session.user.user_metadata?.full_name ||
          session.user.user_metadata?.name ||
          session.user.email?.split("@")[0] ||
          "Anonymous";

        const payload = {
          user_id: session.user.id,
          slug: slugify(title),
          title,
          description: (document.querySelector("#f-description") as HTMLInputElement).value.trim() || null,
          category: (document.querySelector("#f-category") as HTMLInputElement).value.trim() || null,
          cover_url: coverUrl,
          content,
          author_name: authorName,
        };

        const { data: inserted, error } = await supabase
          .from("stories")
          .insert(payload)
          .select("slug")
          .single();

        if (error) throw new Error(error.message);

        window.location.href = `/blog/community/${inserted.slug}/`;
      } catch (err) {
        console.error(err);
        showError(err instanceof Error ? err.message : "Something went wrong. Please try again.");
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish story";
      }
    });
  }

  init();
</script>

<style>
  .notice {
    padding: 24px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    color: var(--muted);
    margin: 32px 0;
  }

  .story-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 32px 0 80px;
  }

  .story-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .story-form .optional {
    color: var(--muted);
    font-weight: 400;
    font-size: 0.8rem;
  }

  .story-form input,
  .story-form textarea {
    padding: 12px 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    font-weight: 400;
  }

  .story-form textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .story-form input[type="file"] {
    padding: 10px 14px;
    cursor: pointer;
  }

  .story-form input:focus,
  .story-form textarea:focus {
    outline: none;
    border-color: #8aa7ff;
    box-shadow: 0 0 0 3px color-mix(in srgb, #8aa7ff 15%, transparent);
  }

  .story-form button {
    align-self: flex-start;
    padding: 12px 26px;
    background: #8aa7ff;
    border: none;
    border-radius: 10px;
    color: #08090d;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    margin-top: 8px;
  }

  .story-form button:hover {
    background: #c2d1ff;
  }

  .story-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-message {
    color: var(--muted);
    font-size: 13px;
    margin: 4px 0 0;
  }

  .form-message.error {
    color: #e57373;
  }
</style>