---
import Layout from "../../layouts/Layout.astro";

export const prerender = false;
---

<Layout title="Independent — Independent Society" description="Meet an independent builder.">
  <div class="container article-wrap" style="padding-top: 60px;" id="profile-container">
    <p class="loading-msg">Loading profile…</p>
  </div>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  const container = document.querySelector("#profile-container") as HTMLElement;
  const slug = window.location.pathname.split("/").filter(Boolean).pop();

  function escapeHtml(str: string) {
    const div = document.createElement("div");
    div.textContent = str ?? "";
    return div.innerHTML;
  }

  function linkRow(label: string, url?: string | null) {
    if (!url) return "";
    return `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" class="profile-link">${label}</a>`;
  }

  function fact(label: string, value?: string | number | null) {
    if (!value) return "";
    return `<div class="profile-fact"><span class="profile-fact-label">${label}</span><span class="profile-fact-value">${escapeHtml(String(value))}</span></div>`;
  }

  async function loadProfile() {
    const { data: { session } } = await supabase.auth.getSession();

    const { data, error } = await supabase
      .from("independents")
      .select("*")
      .eq("slug", slug)
      .eq("status", "approved")
      .single();

    if (error || !data) {
      container.innerHTML = `<p class="empty">Profile not found.</p>`;
      return;
    }

    const location = [data.city, data.country].filter(Boolean).join(", ");
    const isOwner = session?.user?.id === data.user_id;

    container.innerHTML = `
      <a href="/independents/" class="back-link">← All Independents</a>

      <div class="profile-header">
        <div class="profile-avatar">
          ${
            data.photo_url
              ? `<img src="${escapeHtml(data.photo_url)}" alt="${escapeHtml(data.name)}" />`
              : `<span>${escapeHtml(data.name).slice(0, 2).toUpperCase()}</span>`
          }
        </div>
        <div>
          <h1 class="profile-name">${escapeHtml(data.name)}</h1>
          ${location ? `<div class="profile-location">${escapeHtml(location)}</div>` : ""}
        </div>
      </div>

      ${data.bio ? `<p class="profile-bio">${escapeHtml(data.bio)}</p>` : ""}

      <div class="profile-facts">
        ${fact("Role", data.role)}
        ${fact("Currently building", data.currently_building)}
        ${fact("Earns from", data.income_source)}
        ${fact("Independent since", data.independent_since)}
        ${fact("Revenue", data.revenue)}
        ${fact("Working hours", data.working_hours)}
      </div>

      <div class="profile-links">
        ${linkRow("Project", data.project_url)}
        ${linkRow("Website", data.website_url)}
        ${linkRow("X", data.x_url)}
        ${linkRow("LinkedIn", data.linkedin_url)}
      </div>

      ${
        isOwner
          ? `<div class="owner-actions">
              <a href="/independents/edit/${escapeHtml(slug ?? "")}/" class="edit-profile-btn">Edit profile</a>
              <button id="delete-profile-btn" class="delete-profile-btn">Delete profile</button>
            </div>`
          : ""
      }
    `;

    if (isOwner) {
      document.querySelector("#delete-profile-btn")?.addEventListener("click", async () => {
        if (!confirm("Delete your profile? This can't be undone.")) return;
        const { error: deleteError } = await supabase.from("independents").delete().eq("id", data.id);
        if (!deleteError) {
          window.location.href = "/independents/";
        }
      });
    }
  }

  loadProfile();
</script>

<style>
  .loading-msg,
  .empty {
    color: var(--muted);
    padding: 40px 0;
  }

  #profile-container :global(.back-link) {
    display: inline-block;
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 32px;
  }

  #profile-container :global(.back-link:hover) {
    color: var(--text);
  }

  #profile-container :global(.profile-header) {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }

  #profile-container :global(.profile-avatar) {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    overflow: hidden;
    background: color-mix(in srgb, #8aa7ff 15%, transparent);
    color: #8aa7ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 22px;
    flex-shrink: 0;
  }

  #profile-container :global(.profile-avatar img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #profile-container :global(.profile-name) {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0;
  }

  #profile-container :global(.profile-location) {
    color: var(--muted);
    font-size: 0.95rem;
    margin-top: 4px;
  }

  #profile-container :global(.profile-bio) {
    color: var(--text);
    opacity: 0.88;
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 24px 0;
  }

  #profile-container :global(.profile-facts) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
    margin: 32px 0;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
  }

  #profile-container :global(.profile-fact) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #profile-container :global(.profile-fact-label) {
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  #profile-container :global(.profile-fact-value) {
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
  }

  #profile-container :global(.owner-actions) {
    display: flex;
    gap: 12px;
    margin: 0 0 80px;
  }

  #profile-container :global(.edit-profile-btn) {
    padding: 9px 18px;
    background: #8aa7ff;
    border-radius: 10px;
    color: #08090d;
    font-size: 0.88rem;
    font-weight: 700;
  }

  #profile-container :global(.edit-profile-btn:hover) {
    background: #c2d1ff;
  }

  #profile-container :global(.delete-profile-btn) {
    padding: 9px 18px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: #e57373;
    font-size: 0.88rem;
    cursor: pointer;
  }

  #profile-container :global(.delete-profile-btn:hover) {
    border-color: #e57373;
    background: color-mix(in srgb, #e57373 10%, transparent);
  }

  #profile-container :global(.profile-links) {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 32px 0 80px;
  }

  #profile-container :global(.profile-link) {
    padding: 9px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
    transition: border-color 0.2s ease;
  }

  #profile-container :global(.profile-link:hover) {
    border-color: #8aa7ff;
    color: #8aa7ff;
  }
</style>