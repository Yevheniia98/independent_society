---
import Layout from "../../../layouts/Layout.astro";

export const prerender = false;
---

<Layout title="Edit Profile — Independent Society" description="Edit your Independents profile.">
  <div class="container article-wrap" style="padding-top: 60px; max-width: 640px;">
    <div class="eyebrow">Community</div>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem);">Edit Profile</h1>

    <div id="loading-msg" class="notice"><p>Loading your profile…</p></div>
    <div id="signed-out-notice" class="notice" hidden><p>You need to sign in with Google to edit your profile.</p></div>
    <div id="not-owner-notice" class="notice" hidden><p>You can only edit your own profile.</p></div>

    <form id="profile-form" class="profile-form" hidden>
      <label>
        Name *
        <input type="text" id="f-name" required maxlength="80" />
      </label>

      <label>
        Upload Photo <span class="optional">(leave empty to keep the current one)</span>
        <input type="file" id="f-photo" accept="image/png,image/jpeg,image/webp" />
      </label>

      <div class="row-2">
        <label>
          City *
          <input type="text" id="f-city" required maxlength="60" />
        </label>
        <label>
          Country *
          <input type="text" id="f-country" required maxlength="60" />
        </label>
      </div>

      <label>
        Role <span class="optional">(optional)</span>
        <input type="text" id="f-role" maxlength="80" />
      </label>

      <label>
        Currently building <span class="optional">(optional)</span>
        <input type="text" id="f-building" maxlength="120" />
      </label>

      <label>
        What do you earn from? <span class="optional">(optional)</span>
        <input type="text" id="f-income" maxlength="120" />
      </label>

      <label>
        Short bio <span class="optional">(optional)</span>
        <textarea id="f-bio" rows="3" maxlength="500"></textarea>
      </label>

      <div class="row-2">
        <label>
          Independent since (year) <span class="optional">(optional)</span>
          <input type="number" id="f-since" min="1990" max="2026" />
        </label>
        <label>
          Working hours <span class="optional">(optional)</span>
          <input type="text" id="f-hours" maxlength="40" />
        </label>
      </div>

      <label>
        Revenue <span class="optional">(optional)</span>
        <input type="text" id="f-revenue" maxlength="40" />
      </label>

      <label>
        Project URL <span class="optional">(optional)</span>
        <input type="url" id="f-project" />
      </label>

      <label>
        Website *
        <input type="url" id="f-website" required />
      </label>

      <div class="row-2">
        <label>
          X (Twitter) <span class="optional">(optional)</span>
          <input type="url" id="f-x" />
        </label>
        <label>
          LinkedIn <span class="optional">(optional)</span>
          <input type="url" id="f-linkedin" />
        </label>
      </div>

      <button type="submit" id="submit-btn">Save changes</button>
      <p id="form-message" class="form-message"></p>
    </form>
  </div>
</Layout>

<script>
  import { supabase } from "../../../lib/supabase";

  const loadingMsg = document.querySelector("#loading-msg") as HTMLElement;
  const signedOutNotice = document.querySelector("#signed-out-notice") as HTMLElement;
  const notOwnerNotice = document.querySelector("#not-owner-notice") as HTMLElement;
  const form = document.querySelector("#profile-form") as HTMLFormElement;
  const message = document.querySelector("#form-message") as HTMLElement;
  const submitBtn = document.querySelector("#submit-btn") as HTMLButtonElement;

  const slug = window.location.pathname.split("/").filter(Boolean).pop();
  let profileId: string;

  function showError(text: string) {
    message.textContent = text;
    message.className = "form-message error";
  }

  function setVal(id: string, value: unknown) {
    (document.querySelector(id) as HTMLInputElement).value = value != null ? String(value) : "";
  }

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session?.user) {
      loadingMsg.hidden = true;
      signedOutNotice.hidden = false;
      return;
    }

    const { data: profile, error } = await supabase
      .from("independents")
      .select("*")
      .eq("slug", slug)
      .single();

    if (error || !profile) {
      loadingMsg.innerHTML = `<p>Profile not found.</p>`;
      return;
    }

    if (profile.user_id !== session.user.id) {
      loadingMsg.hidden = true;
      notOwnerNotice.hidden = false;
      return;
    }

    profileId = profile.id;
    setVal("#f-name", profile.name);
    setVal("#f-city", profile.city);
    setVal("#f-country", profile.country);
    setVal("#f-role", profile.role);
    setVal("#f-building", profile.currently_building);
    setVal("#f-income", profile.income_source);
    setVal("#f-bio", profile.bio);
    setVal("#f-since", profile.independent_since);
    setVal("#f-hours", profile.working_hours);
    setVal("#f-revenue", profile.revenue);
    setVal("#f-project", profile.project_url);
    setVal("#f-website", profile.website_url);
    setVal("#f-x", profile.x_url);
    setVal("#f-linkedin", profile.linkedin_url);

    loadingMsg.hidden = true;
    form.hidden = false;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      message.textContent = "";
      message.className = "form-message";

      const name = (document.querySelector("#f-name") as HTMLInputElement).value.trim();
      const city = (document.querySelector("#f-city") as HTMLInputElement).value.trim();
      const country = (document.querySelector("#f-country") as HTMLInputElement).value.trim();
      const website = (document.querySelector("#f-website") as HTMLInputElement).value.trim();

      if (!name || !city || !country || !website) {
        showError("Please fill in Name, City, Country, and Website — those are required.");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Saving…";

      try {
        let photoUrl: string | undefined;
        const fileInput = document.querySelector("#f-photo") as HTMLInputElement;
        const file = fileInput.files?.[0];

        if (file) {
          const ext = file.name.split(".").pop();
          const path = `${session.user.id}/${Date.now()}.${ext}`;

          const { error: uploadError } = await supabase.storage
            .from("avatars")
            .upload(path, file, { upsert: true });

          if (uploadError) throw new Error(`Photo upload failed: ${uploadError.message}`);

          const { data: publicUrlData } = supabase.storage.from("avatars").getPublicUrl(path);
          photoUrl = publicUrlData.publicUrl;
        }

        const payload: Record<string, unknown> = {
          name,
          city,
          country,
          website_url: website,
          role: (document.querySelector("#f-role") as HTMLInputElement).value.trim() || null,
          currently_building: (document.querySelector("#f-building") as HTMLInputElement).value.trim() || null,
          income_source: (document.querySelector("#f-income") as HTMLInputElement).value.trim() || null,
          bio: (document.querySelector("#f-bio") as HTMLTextAreaElement).value.trim() || null,
          independent_since: (document.querySelector("#f-since") as HTMLInputElement).value || null,
          working_hours: (document.querySelector("#f-hours") as HTMLInputElement).value.trim() || null,
          revenue: (document.querySelector("#f-revenue") as HTMLInputElement).value.trim() || null,
          project_url: (document.querySelector("#f-project") as HTMLInputElement).value.trim() || null,
          x_url: (document.querySelector("#f-x") as HTMLInputElement).value.trim() || null,
          linkedin_url: (document.querySelector("#f-linkedin") as HTMLInputElement).value.trim() || null,
        };
        if (photoUrl) payload.photo_url = photoUrl;

        const { error: updateError } = await supabase.from("independents").update(payload).eq("id", profileId);

        if (updateError) throw new Error(updateError.message);

        window.location.href = `/independents/${slug}/`;
      } catch (err) {
        console.error(err);
        showError(err instanceof Error ? err.message : "Something went wrong. Please try again.");
        submitBtn.disabled = false;
        submitBtn.textContent = "Save changes";
      }
    });
  }

  init();
</script>

<style>
  .notice {
    padding: 24px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    color: var(--muted);
    margin: 32px 0;
  }

  .profile-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 32px 0 80px;
  }

  .profile-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .profile-form .optional {
    color: var(--muted);
    font-weight: 400;
    font-size: 0.8rem;
  }

  .profile-form input,
  .profile-form textarea {
    padding: 12px 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    font-weight: 400;
  }

  .profile-form input[type="file"] {
    padding: 10px 14px;
    cursor: pointer;
  }

  .profile-form input:focus,
  .profile-form textarea:focus {
    outline: none;
    border-color: #8aa7ff;
    box-shadow: 0 0 0 3px color-mix(in srgb, #8aa7ff 15%, transparent);
  }

  .row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .profile-form button {
    align-self: flex-start;
    padding: 12px 26px;
    background: #8aa7ff;
    border: none;
    border-radius: 10px;
    color: #08090d;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    margin-top: 8px;
  }

  .profile-form button:hover {
    background: #c2d1ff;
  }

  .profile-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-message {
    color: var(--muted);
    font-size: 13px;
    margin: 4px 0 0;
  }

  .form-message.error {
    color: #e57373;
  }

  @media (max-width: 560px) {
    .row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>