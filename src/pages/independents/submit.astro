---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Add Your Profile — Independent Society"
  description="Join the Independents directory — share what you're building and how long you've been at it."
>
  <div class="container article-wrap" style="padding-top: 60px; max-width: 640px;">
    <div class="eyebrow">Community</div>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem);">Add Your Profile</h1>
    <p class="article-lead">
      Tell us what you're building. New profiles are reviewed before they go live —
      you'll see it appear on the Independents page once it's approved.
    </p>

    <div id="signed-out-notice" class="notice" hidden>
      <p>You need to sign in with Google to submit a profile.</p>
    </div>

    <form id="profile-form" class="profile-form" hidden>
      <label>
        Name *
        <input type="text" id="f-name" required maxlength="80" />
      </label>

      <label>
        Upload Photo
        <input type="file" id="f-photo" accept="image/png,image/jpeg,image/webp" />
        <span class="hint">PNG, JPG or WEBP. Optional.</span>
      </label>

      <div class="row-2">
        <label>
          City *
          <input type="text" id="f-city" required maxlength="60" />
        </label>
        <label>
          Country *
          <input type="text" id="f-country" required maxlength="60" />
        </label>
      </div>

      <label>
        Role <span class="optional">(optional)</span>
        <input type="text" id="f-role" placeholder="e.g. Solo founder, Freelance designer" maxlength="80" />
      </label>

      <label>
        Currently building <span class="optional">(optional)</span>
        <input type="text" id="f-building" placeholder="e.g. Building: AI SaaS for freelancers" maxlength="120" />
      </label>

      <label>
        What do you earn from? <span class="optional">(optional)</span>
        <input type="text" id="f-income" placeholder="e.g. SaaS subscriptions, client work" maxlength="120" />
      </label>

      <label>
        Short bio <span class="optional">(optional)</span>
        <textarea id="f-bio" rows="3" maxlength="500"></textarea>
      </label>

      <div class="row-2">
        <label>
          Independent since (year) <span class="optional">(optional)</span>
          <input type="number" id="f-since" min="1990" max="2026" placeholder="2022" />
        </label>
        <label>
          Working hours <span class="optional">(optional)</span>
          <input type="text" id="f-hours" placeholder="e.g. 30h/week" maxlength="40" />
        </label>
      </div>

      <label>
        Revenue <span class="optional">(optional, shown publicly if filled)</span>
        <input type="text" id="f-revenue" placeholder="e.g. €8k MRR" maxlength="40" />
      </label>

      <label>
        Project URL <span class="optional">(optional)</span>
        <input type="url" id="f-project" placeholder="https://..." />
      </label>

      <label>
        Website *
        <input type="url" id="f-website" required placeholder="https://..." />
      </label>

      <div class="row-2">
        <label>
          X (Twitter) <span class="optional">(optional)</span>
          <input type="url" id="f-x" placeholder="https://x.com/..." />
        </label>
        <label>
          LinkedIn <span class="optional">(optional)</span>
          <input type="url" id="f-linkedin" placeholder="https://linkedin.com/in/..." />
        </label>
      </div>

      <button type="submit" id="submit-btn">Submit for review</button>
      <p id="form-message" class="form-message"></p>
    </form>
  </div>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  const signedOutNotice = document.querySelector("#signed-out-notice") as HTMLElement;
  const form = document.querySelector("#profile-form") as HTMLFormElement;
  const message = document.querySelector("#form-message") as HTMLElement;
  const submitBtn = document.querySelector("#submit-btn") as HTMLButtonElement;

  function slugify(name: string) {
    const base = name
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, "-");
    const random = Math.random().toString(36).slice(2, 6);
    return `${base}-${random}`;
  }

  function showError(text: string) {
    message.textContent = text;
    message.className = "form-message error";
  }

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session?.user) {
      signedOutNotice.hidden = false;
      form.hidden = true;
      return;
    }

    signedOutNotice.hidden = true;
    form.hidden = false;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      message.textContent = "";
      message.className = "form-message";

      const name = (document.querySelector("#f-name") as HTMLInputElement).value.trim();
      const city = (document.querySelector("#f-city") as HTMLInputElement).value.trim();
      const country = (document.querySelector("#f-country") as HTMLInputElement).value.trim();
      const website = (document.querySelector("#f-website") as HTMLInputElement).value.trim();

      if (!name || !city || !country || !website) {
        showError("Please fill in Name, City, Country, and Website — those are required.");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting…";

      try {
        // Upload photo, if one was selected
        let photoUrl: string | null = null;
        const fileInput = document.querySelector("#f-photo") as HTMLInputElement;
        const file = fileInput.files?.[0];

        if (file) {
          const ext = file.name.split(".").pop();
          const path = `${session.user.id}/${Date.now()}.${ext}`;

          const { error: uploadError } = await supabase.storage
            .from("avatars")
            .upload(path, file, { upsert: true });

          if (uploadError) {
            throw new Error(`Photo upload failed: ${uploadError.message}`);
          }

          const { data: publicUrlData } = supabase.storage.from("avatars").getPublicUrl(path);
          photoUrl = publicUrlData.publicUrl;
        }

        const payload = {
          user_id: session.user.id,
          slug: slugify(name),
          name,
          photo_url: photoUrl,
          city,
          country,
          role: (document.querySelector("#f-role") as HTMLInputElement).value.trim() || null,
          currently_building: (document.querySelector("#f-building") as HTMLInputElement).value.trim() || null,
          income_source: (document.querySelector("#f-income") as HTMLInputElement).value.trim() || null,
          bio: (document.querySelector("#f-bio") as HTMLTextAreaElement).value.trim() || null,
          independent_since: (document.querySelector("#f-since") as HTMLInputElement).value || null,
          working_hours: (document.querySelector("#f-hours") as HTMLInputElement).value.trim() || null,
          revenue: (document.querySelector("#f-revenue") as HTMLInputElement).value.trim() || null,
          project_url: (document.querySelector("#f-project") as HTMLInputElement).value.trim() || null,
          website_url: website,
          x_url: (document.querySelector("#f-x") as HTMLInputElement).value.trim() || null,
          linkedin_url: (document.querySelector("#f-linkedin") as HTMLInputElement).value.trim() || null,
          status: "pending",
        };

        const { error } = await supabase.from("independents").insert(payload);

        if (error) {
          throw new Error(error.message);
        }

        form.innerHTML = `<p class="success-msg">Thanks! Your profile has been submitted and is waiting for review. It'll appear on the Independents page once approved.</p>`;
      } catch (err) {
        console.error(err);
        showError(err instanceof Error ? err.message : "Something went wrong. Please try again.");
        submitBtn.disabled = false;
        submitBtn.textContent = "Submit for review";
      }
    });
  }

  init();
</script>

<style>
  .notice {
    padding: 24px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    color: var(--muted);
    margin: 32px 0;
  }

  .profile-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 32px 0 80px;
  }

  .profile-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .profile-form .optional {
    color: var(--muted);
    font-weight: 400;
    font-size: 0.8rem;
  }

  .profile-form .hint {
    color: var(--muted);
    font-weight: 400;
    font-size: 0.78rem;
  }

  .profile-form input,
  .profile-form textarea {
    padding: 12px 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    font-weight: 400;
  }

  .profile-form input[type="file"] {
    padding: 10px 14px;
    cursor: pointer;
  }

  .profile-form input:focus,
  .profile-form textarea:focus {
    outline: none;
    border-color: #8aa7ff;
    box-shadow: 0 0 0 3px color-mix(in srgb, #8aa7ff 15%, transparent);
  }

  .row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .profile-form button {
    align-self: flex-start;
    padding: 12px 26px;
    background: #8aa7ff;
    border: none;
    border-radius: 10px;
    color: #08090d;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    margin-top: 8px;
  }

  .profile-form button:hover {
    background: #c2d1ff;
  }

  .profile-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-message {
    color: var(--muted);
    font-size: 13px;
    margin: 4px 0 0;
  }

  .form-message.error {
    color: #e57373;
  }

  .success-msg {
    color: var(--text);
    font-size: 1rem;
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  @media (max-width: 560px) {
    .row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>